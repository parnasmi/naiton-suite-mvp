{
  "searchShortcut": "MetaOrCtrl+K",
  "templateDir": "templates/fsd-app",
  "routing": {
    "versionSourceField": "frontend_version",
    "latestVersionField": "latest_frontend_version",
    "fallbackStrategy": "latest",
    "hosts": {
      "shell": "app.naiton.com",
      "sales": "sales.naiton.com",
      "crm": "crm.naiton.com",
      "fms": "fms.naiton.com",
      "admin": "admin.naiton.com"
    },
    "paths": {
      "shell": "/{semver}/shell",
      "sales": "/{semver}/",
      "crm": "/{semver}/",
      "fms": "/{semver}/",
      "admin": "/{semver}/"
    }
  },
  "api": {
    "workspace": "apps/api-mock",
    "port": 4000,
    "baseUrl": "http://localhost:4000",
    "apiBaseUrl": "http://localhost:4000/api"
  },
  "apps": {
    "shell": {
      "workspace": "apps/shell",
      "port": 3000,
      "routeTemplate": "/{semver}/shell"
    },
    "sales": {
      "workspace": "apps/sales",
      "port": 3001,
      "routeTemplate": "/{semver}/"
    },
    "crm": {
      "workspace": "apps/crm",
      "port": 3002,
      "routeTemplate": "/{semver}/"
    },
    "fms": {
      "workspace": "apps/fms",
      "port": 3003,
      "routeTemplate": "/{semver}/"
    },
    "admin": {
      "workspace": "apps/admin",
      "port": 3004,
      "routeTemplate": "/{semver}/"
    }
  },
  "pathAliases": {
    "frontend": [
      "@/*",
      "@app/*",
      "@pages/*",
      "@widgets/*",
      "@features/*",
      "@entities/*",
      "@shared/*"
    ],
    "packages": [
      "@naiton/ui-kit",
      "@naiton/search-engine",
      "@naiton/contracts"
    ]
  },
  "envVars": {
    "apiPort": "NAITON_API_PORT",
    "apiBaseUrl": "NAITON_API_BASE_URL",
    "versionSourceField": "NAITON_VERSION_SOURCE_FIELD",
    "latestVersionField": "NAITON_LATEST_VERSION_FIELD",
    "versionFallback": "NAITON_VERSION_FALLBACK",
    "shellHost": "NAITON_SHELL_HOST",
    "salesHost": "NAITON_SALES_HOST",
    "crmHost": "NAITON_CRM_HOST",
    "fmsHost": "NAITON_FMS_HOST",
    "adminHost": "NAITON_ADMIN_HOST"
  }
}
