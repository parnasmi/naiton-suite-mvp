{
  "name": "@naiton/sales",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "node ../../scripts/placeholder-task.mjs lint @naiton/sales",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/placeholder-task.mjs test @naiton/sales"
  },
  "dependencies": {
    "@naiton/contracts": "workspace:*",
    "@naiton/search-engine": "workspace:*",
    "@naiton/ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.80.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "naiton": {
    "kind": "frontend-app",
    "port": 3001,
    "routeTemplate": "/{semver}/",
    "productionHostEnvVar": "NAITON_SALES_HOST",
    "template": "templates/fsd-app"
  }
}
