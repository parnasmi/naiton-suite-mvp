# Shared
NAITON_API_PORT=4000
NAITON_API_BASE_URL=http://localhost:4000/api
NAITON_VERSION_SOURCE_FIELD=frontend_version
NAITON_LATEST_VERSION_FIELD=latest_frontend_version
NAITON_VERSION_FALLBACK=latest

# Frontend app ports
SHELL_PORT=3000
SALES_PORT=3001
CRM_PORT=3002
FMS_PORT=3003
ADMIN_PORT=3004

# Production hosts
NAITON_SHELL_HOST=app.naiton.com
NAITON_SALES_HOST=sales.naiton.com
NAITON_CRM_HOST=crm.naiton.com
NAITON_FMS_HOST=fms.naiton.com
NAITON_ADMIN_HOST=admin.naiton.com

# Runtime route templates (semver is profile-driven)
SHELL_ROUTE_TEMPLATE=/{semver}/shell
SALES_ROUTE_TEMPLATE=/{semver}/
CRM_ROUTE_TEMPLATE=/{semver}/
FMS_ROUTE_TEMPLATE=/{semver}/
ADMIN_ROUTE_TEMPLATE=/{semver}/
